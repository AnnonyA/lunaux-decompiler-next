+            descriptions.append(
+                "count=top"
+                if semantics.is_open
+                else f"count={semantics.fixed_value_count}"
+            )
     elif name == "CALLFB":
         slot = "sealed" if instruction.aux == 0xFFFFFFFF else instruction.aux
         descriptions.append(f"feedback_slot={slot}")
